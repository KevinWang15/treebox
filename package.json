{
  "name": "@kevinwang15/treebox",
  "version": "0.1.3",
  "main": "./build/treebox.js",
  "files": [
    "CHANGELOG.md",
    "build/treebox.js",
    "build/treebox.js.map"
  ],
  "dependencies": {},
  "description": "Treebox is an interactive TreeMap visualization",
  "keywords": [
    "treemap",
    "visualization",
    "canvas",
    "data"
  ],
  "scripts": {
    "build-lib": "vite build --mode library",
    "start": "vite",
    "build": "vite build",
    "benchmark": "vitest bench --run",
